	<file source-language="en" datatype="plaintext" original="EXT:api_key/Resources/Private/Language/locallang_mod.xlf" date="2026-10-28T00:00:00Z" product-name="api_key">
		<header/>
		<body>
			<trans-unit id="mlang_tabs_tab">
				<source>API Keys</source>
			</trans-unit>
			<trans-unit id="mlang_labels_tablabel">
				<source>Create and revoke API keys</source>
			</trans-unit>
			<trans-unit id="mlang_labels_tabdescr">
				<source>Create API keys for scripts, cron jobs and server-to-server integrations. The key is shown once after creation; only its hash is stored.</source>
			</trans-unit>
			<trans-unit id="module.back">
				<source>Back</source>
			</trans-unit>
			<trans-unit id="module.new.title">
				<source>Create API key</source>
			</trans-unit>
			<trans-unit id="module.empty.title">
				<source>No API keys yet</source>
			</trans-unit>
			<trans-unit id="module.empty.message">
				<source>Create a key here or with the console command apikey:create.</source>
			</trans-unit>
			<trans-unit id="module.column.title">
				<source>Title</source>
			</trans-unit>
			<trans-unit id="module.column.identifier">
				<source>Identifier</source>
			</trans-unit>
			<trans-unit id="module.column.identity">
				<source>Identity</source>
			</trans-unit>
			<trans-unit id="module.column.scopes">
				<source>Scopes</source>
			</trans-unit>
			<trans-unit id="module.column.expires">
				<source>Expires</source>
			</trans-unit>
			<trans-unit id="module.column.lastUsed">
				<source>Last used</source>
			</trans-unit>
			<trans-unit id="module.column.status">
				<source>Status</source>
			</trans-unit>
			<trans-unit id="module.identity.service">
				<source>Service key</source>
			</trans-unit>
			<trans-unit id="module.identity.fe_user">
				<source>Frontend user</source>
			</trans-unit>
			<trans-unit id="module.identity.be_user">
				<source>Backend user</source>
			</trans-unit>
			<trans-unit id="module.scopes.all">
				<source>all</source>
			</trans-unit>
			<trans-unit id="module.never">
				<source>never</source>
			</trans-unit>
			<trans-unit id="module.status.active">
				<source>active</source>
			</trans-unit>
			<trans-unit id="module.status.expired">
				<source>expired</source>
			</trans-unit>
			<trans-unit id="module.status.revoked">
				<source>revoked</source>
			</trans-unit>
			<trans-unit id="module.edit">
				<source>Edit</source>
			</trans-unit>
			<trans-unit id="module.revoke">
				<source>Revoke</source>
			</trans-unit>
			<trans-unit id="module.revoke.confirm.title">
				<source>Revoke API key?</source>
			</trans-unit>
			<trans-unit id="module.revoke.confirm.message">
				<source>Requests with this key are rejected from now on. The record stays for auditing.</source>
			</trans-unit>
			<trans-unit id="module.revoke.success">
				<source>Revoked API key "%s" (%s).</source>
			</trans-unit>
			<trans-unit id="module.field.title">
				<source>Title</source>
			</trans-unit>
			<trans-unit id="module.field.title.description">
				<source>A label that tells you where the key is used, e.g. "CI deploy script".</source>
			</trans-unit>
			<trans-unit id="module.field.identity">
				<source>Identity</source>
			</trans-unit>
			<trans-unit id="module.field.identity.description">
				<source>A service key acts without a user. A key bound to a user stops working while that user is deleted or disabled.</source>
			</trans-unit>
			<trans-unit id="module.field.fe_user">
				<source>Frontend user uid</source>
			</trans-unit>
			<trans-unit id="module.field.be_user">
				<source>Backend user</source>
			</trans-unit>
			<trans-unit id="module.field.scopes">
				<source>Scopes</source>
			</trans-unit>
			<trans-unit id="module.field.scopes.description">
				<source>One scope per line. Leave empty to allow everything.</source>
			</trans-unit>
			<trans-unit id="module.field.expires_at">
				<source>Expires at</source>
			</trans-unit>
			<trans-unit id="module.field.expires_at.description">
				<source>The key stops working at the start of this day. Leave empty for a key that never expires.</source>
			</trans-unit>
			<trans-unit id="module.field.allowed_ips">
				<source>Allowed IP addresses</source>
			</trans-unit>
			<trans-unit id="module.field.allowed_ips.description">
				<source>One IP address or CIDR range per line. Leave empty to allow any address.</source>
			</trans-unit>
			<trans-unit id="module.field.sites">
				<source>Sites</source>
			</trans-unit>
			<trans-unit id="module.field.sites.description">
				<source>Select none to allow every site.</source>
			</trans-unit>
			<trans-unit id="module.create.submit">
				<source>Create key</source>
			</trans-unit>
			<trans-unit id="module.create.error">
				<source>The key was not created</source>
			</trans-unit>
			<trans-unit id="module.created.title">
				<source>Key created</source>
			</trans-unit>
			<trans-unit id="module.created.message">
				<source>Copy the key now and store it somewhere safe. It is not shown again and cannot be recovered; only its hash is stored.</source>
			</trans-unit>
			<trans-unit id="module.created.key">
				<source>API key</source>
			</trans-unit>
			<trans-unit id="module.created.copy">
				<source>Copy API key</source>
			</trans-unit>
			<trans-unit id="module.created.usage">
				<source>Send it in the X-API-Key header or as bearer token, for example:</source>
			</trans-unit>
		</body>
	</file>
